# Opcional: chave legada service_role (JWT) se preferir no servidor
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Cerca virtual: fallback de bootstrap; a tela de Configuracoes sobrescreve ponto e raio no banco
# Somente servidor; nunca use prefixo NEXT_PUBLIC_
