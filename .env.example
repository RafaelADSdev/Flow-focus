OFFICE_LNG=-00.0000
OFFICE_RADIUS_METERS=150
GEO_SESSION_SECONDS=30
# Recomendado: segredo dedicado com 32+ caracteres. Sem ele, o servidor usa a chave secreta do Supabase.
